rules_version = '2';

// FIFI — a jar is shared by exactly two people and nobody else can see it.
//
// The web config is public, so these rules are the only thing standing
// between a jar and the internet. Every path below is deny-by-default;
// nothing is readable without being a member of that couple.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function coupleMembers(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    function isMemberOf(coupleId) {
      return signedIn() && uid() in coupleMembers(coupleId);
    }

    // --- the cooldown ------------------------------------------------------
    // How long one person waits between fireflies. Enforced here and not only
    // in the app: a limit the client can skip by opening devtools is not a
    // limit, and scarcity is the whole point of a firefly.
    function cooldownMins(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId))
        .data.get('cooldownMins', 15);
    }

    function cooldownPath(coupleId) {
      return /databases/$(database)/documents/couples/$(coupleId)/cooldowns/$(uid());
    }

    // Your own last release. Absent the first time, which always passes.
    function cooldownElapsed(coupleId) {
      return cooldownMins(coupleId) <= 0
        || !exists(cooldownPath(coupleId))
        || request.time >= get(cooldownPath(coupleId)).data.at
             + duration.value(cooldownMins(coupleId), 'm');
    }

    // --- users -------------------------------------------------------------
    // Your own profile, nobody else's.
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // --- invites -----------------------------------------------------------
    // Readable by anyone signed in who knows the code — that is the point of
    // an invite. Claimable exactly once, and only by someone who isn't the
    // person who made it.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && request.resource.data.claimedBy == null;

      allow update: if signedIn()
        && resource.data.claimedBy == null
        && resource.data.createdBy != uid()
        && request.resource.data.claimedBy == uid()
        && request.resource.data.coupleId == resource.data.coupleId
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if signedIn() && resource.data.createdBy == uid();
    }

    // --- couples -----------------------------------------------------------
    match /couples/{coupleId} {
      // read covers both get and list. Rules are not filters: a list only
      // succeeds if the query itself is constrained so every document it can
      // return satisfies this, which is exactly what
      //   where("members", "array-contains", uid)
      // does. So you can enumerate your own jars and no one else's.
      allow read: if signedIn() && uid() in resource.data.members;

      // You may only create a jar with yourself in it.
      allow create: if signedIn()
        && request.resource.data.members == [uid()];

      // Two ways to write: you are already a member, or you are the second
      // person joining a jar that currently holds one. A jar never grows
      // past two, and members can never be removed or reordered.
      allow update: if signedIn() && (
        uid() in resource.data.members
        || (
          resource.data.members.size() == 1
          && request.resource.data.members == resource.data.members.concat([uid()])
        )
      );

      // Only a jar still waiting on its second person, and only by the person
      // who made it. Once two people are in, the forest is shared history and
      // neither of them can delete it out from under the other.
      allow delete: if signedIn() && resource.data.members == [uid()];

      // --- when each person last released ---------------------------------
      // A document per person, so only you can stamp yours. Keeping it out of
      // the jar document means neither of you can push the other's next
      // firefly further away.
      match /cooldowns/{userId} {
        allow read: if isMemberOf(coupleId);
        // Must be the server's clock, or you could backdate your way out of
        // the wait.
        allow write: if isMemberOf(coupleId)
          && userId == uid()
          && request.resource.data.at == request.time;
      }

      // --- one night of the shared forest ---------------------------------
      match /nights/{nightId} {
        allow read, write: if isMemberOf(coupleId);

        // Each firefly. Immutable once released — you cannot un-miss someone,
        // and neither person can rewrite the other's history.
        match /taps/{tapId} {
          allow read: if isMemberOf(coupleId);
          allow create: if isMemberOf(coupleId)
            && request.resource.data.uid == uid()
            && cooldownElapsed(coupleId);
          allow update, delete: if false;
        }
      }
    }
  }
}
